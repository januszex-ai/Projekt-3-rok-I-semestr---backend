{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git switch:*)",
      "Bash(git pull --ff-only:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin HEAD)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh project:*)",
      "Bash(.claude/skills/menel-workflow/scripts/board.sh:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose exec -T app php artisan test:*)",
      "Bash(docker compose exec -T app ./vendor/bin/pint:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)"
    ],
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(git rebase:*)",
      "Bash(git branch -D:*)",
      "Bash(composer require:*)",
      "Bash(npm install:*)",
      "Bash(docker compose exec -T app composer require:*)",
      "Edit(.github/workflows/**)",
      "Write(.github/workflows/**)",
      "Edit(docker-compose.yml)",
      "Edit(docker/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.testing)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh pr merge --admin:*)",
      "Bash(gh pr review --approve:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh repo delete:*)",
      "Bash(docker compose down -v:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
